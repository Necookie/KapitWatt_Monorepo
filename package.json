{
  "name": "kapitwatt",
  "version": "0.1.0",
  "private": true,
  "description": "KapitWatt: residential demand response for Meralco (IDOL Hackathon 2026, team CodeBearers)",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "doppler run -- pnpm --filter @kapitwatt/api dev",
    "dev:mobile": "doppler run -- pnpm --filter @kapitwatt/mobile start",
    "dev:dashboard": "doppler run -- pnpm --filter @kapitwatt/dashboard web",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r typecheck && pnpm --filter @kapitwatt/api build && pnpm --filter @kapitwatt/dashboard build",
    "db:migrate": "doppler run -- pnpm --filter @kapitwatt/db migrate",
    "db:smoke": "doppler run -- pnpm --filter @kapitwatt/db smoke",
    "db:seed": "doppler run -- pnpm --filter @kapitwatt/db seed",
    "demo:accounts": "doppler run -- pnpm --filter @kapitwatt/api demo:accounts",
    "demo:reset": "doppler run -- pnpm --filter @kapitwatt/api demo:reset",
    "demo:seed-search": "doppler run -- pnpm --filter @kapitwatt/api demo:seed-search",
    "deploy:api": "doppler run -- node apps/api/scripts/deploy.mjs",
    "deploy:dashboard": "doppler run -- pnpm --filter @kapitwatt/dashboard build && pnpm --filter @kapitwatt/api exec wrangler deploy --config ../dashboard/wrangler.jsonc"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  }
}
