    "seed": "tsx --env-file-if-exists=../../.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@kapitwatt/shared": "workspace:*",
    "@neondatabase/serverless": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
