{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://kapitwatt-api.dheyn-main.workers.dev"
      }
    },
    "release": {
      "distribution": "internal",
      "channel": "release",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://kapitwatt-api.dheyn-main.workers.dev"
      }
    }
  }
}
