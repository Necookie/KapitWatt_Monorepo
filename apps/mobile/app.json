{
  "expo": {
    "name": "KapitWatt",
    "slug": "kapitwatt",
    "scheme": "kapitwatt",
    "version": "0.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f8ba0025-2fb3-4fa2-bcb4-a4f74b1e35dd",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "../../packages/assets/logo/png/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.codebearers.kapitwatt",
      "adaptiveIcon": {
        "backgroundColor": "#171C8F",
        "foregroundImage": "../../packages/assets/logo/png/android-icon-foreground.png",
        "backgroundImage": "../../packages/assets/logo/png/android-icon-background.png",
        "monochromeImage": "../../packages/assets/logo/png/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "KapitWatt uses the camera to photograph your electricity meter during grid events.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KapitWatt checks that meter photos are taken at your registered home address."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f8ba0025-2fb3-4fa2-bcb4-a4f74b1e35dd"
      }
    },
    "owner": "necookie"
  }
}
