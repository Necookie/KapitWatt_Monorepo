# Copy to .env.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Demo only. These ship in the web bundle, so they are not real secrets.
EXPO_PUBLIC_OPERATOR_KEY=change-me
EXPO_PUBLIC_SIM_KEY=change-me

# Set to 1 to run on built-in fixture data (the simulator in the browser) instead of the API.
EXPO_PUBLIC_FIXTURES=0
