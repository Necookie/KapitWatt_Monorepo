{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kapitwatt-api",
  // Cloudflare account the API deploys to. An identifier, not a secret.
  "account_id": "668f78c5a9581c5051bd60a4985d6166",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // "demo" enables the /sim/* routes. Anything else turns them off.
    "APP_ENV": "demo",
  },
  // Secrets (never commit): DATABASE_URL, SIM_KEY, OPERATOR_KEY.
  //   local:  copy .dev.vars.example to .dev.vars
  //   deploy: wrangler secret put <NAME>
  //
  // Photo storage is undecided (R2 or Supabase Storage). If R2:
  // "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "kapitwatt-meter-photos" }]
}
