// get.kapitwatt.dhekode.com: the download page for the household app, static assets on Cloudflare
// Workers. Build first (`pnpm --filter @kapitwatt/landing build`), or run `pnpm deploy:landing` from
// the repo root, which does both. The APK itself is on GitHub Releases (too big for static assets).
{
  "name": "kapitwatt-landing",
  "account_id": "668f78c5a9581c5051bd60a4985d6166",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "get.kapitwatt.dhekode.com", "custom_domain": true }],
}
